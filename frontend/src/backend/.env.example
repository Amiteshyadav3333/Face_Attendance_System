# Database Config
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=attendance_system
# Optional CA bundle path for verified TLS connections (required for TiDB Cloud).
DB_SSL_CA=

# Firebase Admin SDK
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# File ko is folder mein rakh do aur naam yahan daalo
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Use a long random value in production to sign short-lived liveness challenges
LIVENESS_SECRET=replace_with_a_long_random_secret

# Interview practice (Gemini takes priority if both providers are configured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
